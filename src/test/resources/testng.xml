<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd" >
<suite name="SauceDemo Automation Suite" verbose="1" parallel="false">

    <!--
      Change browser here OR pass via Maven:
        mvn test -Dbrowser=chrome
        mvn test -Dbrowser=firefox
        mvn test -Dbrowser=edge
    -->
    <parameter name="browser" value="chrome"/>

    <!-- ExtentTestListener is attached via @Listeners on BaseTest -->

    <test name="SauceDemo Flow">
        <classes>
            <class name="com.saucedemo.tests.TestCases"/>
        </classes>
    </test>

</suite>
